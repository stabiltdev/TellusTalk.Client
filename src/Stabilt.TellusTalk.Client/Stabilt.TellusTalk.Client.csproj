<Project Sdk="Microsoft.NET.Sdk">

  <!-- net10.0, the oldest .NET still supported, and the first 10.0 Microsoft.Extensions packages, so an app on any
       supported .NET can take it without being made to upgrade. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <Description>A typed client for TellusTalk's K8 send API: sends SMS with IHttpClientFactory, configured from the app's configuration or in code.</Description>
    <Authors>Stabilt AB</Authors>
    <Company>Stabilt AB</Company>
    <PackageTags>tellustalk;sms;client;httpclient</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/stabiltdev/TellusTalk.Client</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
